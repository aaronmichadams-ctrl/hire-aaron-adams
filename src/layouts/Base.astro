---
import { person, seo } from '../data/aaron';
import '@fontsource-variable/dm-sans';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const { title = seo.title, description = seo.description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL('/og.png', Astro.site).toString();
const onHome = Astro.url.pathname === '/';
const href = (hash: string) => (onHome ? hash : `/${hash}`);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={person.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Aaron Adams profile card: operations, sales, marketing and programs, Atlanta metro, GA." />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: person.name,
      jobTitle: person.role,
      email: `mailto:${person.email}`,
      telephone: person.phone,
      url: person.url,
      sameAs: [person.linkedin],
      image: new URL(person.photo, Astro.site).toString(),
      address: { '@type': 'PostalAddress', addressLocality: 'Atlanta', addressRegion: 'GA', addressCountry: 'US' },
    })} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <a class="top-logo" href="/">AARON ADAMS</a>
      <nav class="top-nav" aria-label="Sections">
        <a href={href('#career')}>Career</a>
        <a href={href('#highlights')}>Highlights</a>
        <a href={href('#started')}>Ventures</a>
      </nav>
      <a class="top-round" href={person.linkedin} rel="noopener" aria-label="LinkedIn">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 9v9.5M6.5 5.5v.01M10.5 18.5v-6a3 3 0 0 1 6 0v6M10.5 12.5v6" /></svg>
      </a>
      <a class="top-round" href={`mailto:${person.email}`} aria-label="Email">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7l8 6 8-6M4 6h16v12H4z" /></svg>
      </a>
      <a class="top-cta" href={person.resumePdf} download>Resume</a>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="foot">
      <p><strong>Aaron Adams</strong> · {person.location}</p>
      <p><a href={`mailto:${person.email}`}>{person.email}</a> · <a href={person.phoneHref}>{person.phone}</a> · <a href="/resume">Plain-text resume</a></p>
    </footer>
  </body>
</html>
