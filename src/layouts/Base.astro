---
import { person, seo } from '../data/aaron';
import '@fontsource-variable/instrument-sans';
import '@fontsource-variable/inter';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Text after the name in the file bar, e.g. "Portfolio" or "Resume". */
  file?: string;
  noindex?: boolean;
}
const { title = seo.title, description = seo.description, file = 'Portfolio 2026', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL('/og.png', Astro.site).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={person.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Aaron Adams. I run operations, programs and teams. Atlanta metro, GA." />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: person.name,
      jobTitle: person.role,
      email: `mailto:${person.email}`,
      telephone: person.phone,
      url: person.url,
      sameAs: [person.linkedin],
      address: { '@type': 'PostalAddress', addressLocality: 'Atlanta', addressRegion: 'GA', addressCountry: 'US' },
    })} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="bar">
      <a class="bar-file" href="/">
        <span class="bar-mark" aria-hidden="true"></span>
        <span class="bar-name">{person.name}</span>
        <span class="bar-sep" aria-hidden="true">/</span>
        <span class="bar-doc">{file}</span>
      </a>
      <nav class="bar-actions" aria-label="Quick actions">
        <a class="bar-link" href={person.linkedin} rel="noopener">LinkedIn</a>
        <a class="bar-link hide-sm" href={`mailto:${person.email}`}>Email</a>
        <a class="bar-cta" href={person.resumePdf} download>Download resume</a>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
  </body>
</html>
