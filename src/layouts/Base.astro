---
import { person, seo } from '../data/aaron';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** When true, this page IS the boring view (e.g. /resume). */
  boringPage?: boolean;
  noindex?: boolean;
}
const { title = seo.title, description = seo.description, boringPage = false, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL('/og.png', Astro.site).toString();
---
<!doctype html>
<html lang="en" data-boring={boringPage ? 'true' : undefined} data-boring-page={boringPage ? 'true' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#f6efe0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={person.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A cream thermal receipt reading: Aaron Adams. Operations and general management. Hand me a problem." />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: person.name,
      jobTitle: person.role,
      email: `mailto:${person.email}`,
      telephone: person.phone,
      url: person.url,
      address: { '@type': 'PostalAddress', addressLocality: 'Atlanta', addressRegion: 'GA', addressCountry: 'US' },
    })} />

    <!-- Apply boring mode before first paint so there is no flash. -->
    <script is:inline>
      try {
        if (!document.documentElement.dataset.boringPage && localStorage.getItem('boring') === '1') {
          document.documentElement.dataset.boring = 'true';
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/">{person.name}</a>
      <nav class="header-actions" aria-label="Quick actions">
        <a
          class="boring-toggle"
          href={boringPage ? '/' : '/resume'}
          data-boring-toggle
          aria-label="Boring mode: plain resume layout"
        >
          <span class="bt-track" aria-hidden="true"><span class="bt-knob"></span></span>
          <span class="bt-label">My boss is walking by</span>
        </a>
        <a class="btn-resume" href={person.resumePdf} download>Download resume <span class="r-muted">(PDF)</span></a>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>

    <script>
      // Boring mode switch. Without JS it is a plain link to /resume, which is the same view.
      const root = document.documentElement;
      const isBoringPage = root.dataset.boringPage === 'true';
      document.querySelectorAll<HTMLAnchorElement>('[data-boring-toggle]').forEach((el) => {
        const sync = () => el.setAttribute('aria-checked', root.dataset.boring === 'true' ? 'true' : 'false');
        el.setAttribute('role', 'switch');
        sync();
        el.addEventListener('click', (e) => {
          if (isBoringPage) {
            try { localStorage.setItem('boring', '0'); } catch (err) {}
            return; // follow the link home, in fun mode
          }
          e.preventDefault();
          const on = root.dataset.boring !== 'true';
          if (on) root.dataset.boring = 'true';
          else delete root.dataset.boring;
          try { localStorage.setItem('boring', on ? '1' : '0'); } catch (err) {}
          sync();
          window.scrollTo({ top: 0 });
          document.getElementById('main')?.focus({ preventScroll: true });
        });
        // Keyboard: role=switch should toggle on Space as well as Enter.
        el.addEventListener('keydown', (e) => {
          if (e.key === ' ') { e.preventDefault(); el.click(); }
        });
      });
    </script>
  </body>
</html>
