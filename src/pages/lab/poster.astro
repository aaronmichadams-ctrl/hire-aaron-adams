---
// Direction C: Poster. Bold color fields, huge type, strong grid.
import Base from '../../layouts/Base.astro';
import { person, results, jobs, ventures } from '../../data/aaron';
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/inter';
---
<Base title="Lab C · Poster" noindex>
  <div class="po">
    <section class="po-hero">
      <p class="po-tag">Operations · Programs · Teams</p>
      <h1>Aaron<br />Adams</h1>
      <div class="po-hero-foot">
        <p class="po-lede">I run operations, programs and teams. {person.location}.</p>
        <a class="po-btn" href={person.resumePdf} download>Download resume ↓</a>
      </div>
    </section>

    <section class="po-nums" aria-labelledby="po-n">
      <h2 id="po-n" class="po-h">By the numbers</h2>
      <ul>
        {results.map((r) => <li><span class="big">{r.figure}</span><span>{r.plain}</span></li>)}
      </ul>
    </section>

    <section class="po-jobs" aria-labelledby="po-j">
      <h2 id="po-j" class="po-h">Where I've worked</h2>
      <ol>
        {jobs.map((j, i) => (
          <li>
            <span class="idx">{String(i + 1).padStart(2, '0')}</span>
            <div><h3>{j.org}</h3><p>{j.title}</p></div>
            <span class="when">{j.dates}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="po-ventures" aria-labelledby="po-v">
      <h2 id="po-v" class="po-h">Started by me</h2>
      <ul>
        {ventures.map((v) => <li><h3>{v.name}</h3><p>{v.pitch}</p><span class="when">{v.when}</span></li>)}
      </ul>
    </section>

    <section class="po-contact" aria-labelledby="po-c">
      <h2 id="po-c">Let's<br />talk.</h2>
      <p><a href={`mailto:${person.email}`}>{person.email}</a></p>
      <p><a href={person.phoneHref}>{person.phone}</a> · <a href={person.linkedin} rel="noopener">LinkedIn</a></p>
    </section>
  </div>
</Base>

<style>
  :global(main) { max-width: none; padding: 0; }
  :global(body) { background: #111; }
  :global(.site-header) { background: #ff5b2e; border-image: none; border-bottom: 2px solid #111; color: #111; }
  :global(.brand) { font-family: 'Bricolage Grotesque Variable', sans-serif; font-weight: 800; letter-spacing: -.02em; }
  :global(.btn-resume) { background: #111; color: #fff; box-shadow: none; transform: none; border-radius: 0; }
  :global(.btn-resume .r-muted) { color: #bbb; }
  :global(.bt-track) { background: #ff5b2e; }
  .po { font-family: 'Inter Variable', system-ui, sans-serif; color: #111; }
  .po section { padding: 3rem 1.25rem; }
  @media (min-width: 900px) { .po section { padding: 5rem 4rem; } }
  .po-h { font-size: .85rem; letter-spacing: .14em; text-transform: uppercase; margin: 0 0 2rem; font-weight: 700; }
  .po-hero { background: #ff5b2e; min-height: min(88svh, 50rem); display: flex; flex-direction: column; justify-content: space-between; gap: 2rem; }
  .po-tag { font-weight: 700; letter-spacing: .14em; text-transform: uppercase; margin: 0; font-size: .9rem; }
  .po-hero h1 { font-family: 'Bricolage Grotesque Variable', sans-serif; font-weight: 800; font-size: clamp(5rem, 22vw, 17rem); line-height: .82; letter-spacing: -.06em; margin: 0; }
  .po-hero-foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 1.5rem; border-top: 2px solid #111; padding-top: 1.25rem; }
  .po-lede { font-size: clamp(1.2rem, 3vw, 1.7rem); font-weight: 600; margin: 0; max-width: 34rem; }
  .po-btn { background: #111; color: #fff; padding: 1rem 1.5rem; font-weight: 700; text-decoration: none; font-size: 1.1rem; }
  .po-nums { background: #1f37ff; color: #fff; }
  .po-nums ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 2.5rem 2rem; }
  .po-nums li { display: grid; gap: .6rem; border-top: 2px solid #fff; padding-top: 1rem; font-size: 1.05rem; line-height: 1.45; }
  .big { font-family: 'Bricolage Grotesque Variable', sans-serif; font-weight: 800; font-size: clamp(3rem, 6.5vw, 4.25rem); line-height: .9; letter-spacing: -.04em; }
  .po-jobs { background: #f3ede2; }
  .po-jobs ol { list-style: none; margin: 0; padding: 0; }
  .po-jobs li { display: grid; grid-template-columns: 3rem 1fr; gap: .25rem 1rem; padding: 1.25rem 0; border-top: 2px solid #111; align-items: baseline; }
  .po-jobs .when { grid-column: 2; font-size: .95rem; color: #4a453d; }
  @media (min-width: 760px) { .po-jobs li { grid-template-columns: 4rem 1fr auto; } .po-jobs .when { grid-column: auto; } }
  .idx { font-family: 'Bricolage Grotesque Variable', sans-serif; font-weight: 800; font-size: 1.3rem; }
  .po-jobs h3 { font-family: 'Bricolage Grotesque Variable', sans-serif; font-size: clamp(1.6rem, 4.5vw, 2.6rem); font-weight: 800; letter-spacing: -.03em; margin: 0; line-height: 1; }
  .po-jobs p { margin: .3rem 0 0; }
  .po-ventures { background: #ffd23f; }
  .po-ventures ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 1.5rem; }
  .po-ventures li { background: #111; color: #fff; padding: 1.5rem; display: flex; flex-direction: column; gap: .5rem; }
  .po-ventures h3 { font-family: 'Bricolage Grotesque Variable', sans-serif; font-size: 2rem; font-weight: 800; margin: 0; letter-spacing: -.03em; }
  .po-ventures p { margin: 0; line-height: 1.45; color: #e8e8e8; }
  .po-ventures .when { margin-top: auto; color: #ffd23f; font-weight: 700; }
  .po-contact { background: #111; color: #fff; }
  .po-contact h2 { font-family: 'Bricolage Grotesque Variable', sans-serif; font-weight: 800; font-size: clamp(4rem, 16vw, 11rem); line-height: .85; letter-spacing: -.06em; margin: 0 0 2rem; color: #ff5b2e; }
  .po-contact p { font-size: clamp(1.2rem, 3vw, 1.8rem); margin: 0 0 .5rem; font-weight: 600; }
  .po-contact a { color: #fff; text-underline-offset: 5px; }
</style>
