---
// Direction A: Editorial. Calm, confident, magazine-like. One serif, one sans, one accent.
import Base from '../../layouts/Base.astro';
import { person, board, results, jobs, skills, ventures } from '../../data/aaron';
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource-variable/inter';
const featured = jobs.slice(0, 3);
const earlier = jobs.slice(3);
---
<Base title="Lab A · Editorial" noindex>
  <div class="ed">
    <header class="ed-hero">
      <p class="ed-kicker">{person.location} · Open to operations, program management, growth and general management roles</p>
      <h1 class="ed-name">Aaron Adams</h1>
      <p class="ed-line"><em>runs operations, programs and teams.</em></p>
      <div class="ed-hero-grid">
        <p class="ed-lede">{person.positioning}</p>
        <div class="ed-actions">
          <a class="ed-btn" href={person.resumePdf} download>Download resume</a>
          <a class="ed-link" href={person.linkedin} rel="noopener">LinkedIn ↗</a>
          <a class="ed-link" href={`mailto:${person.email}`}>{person.email}</a>
        </div>
      </div>
    </header>

    <section class="ed-results" aria-labelledby="ed-r">
      <h2 id="ed-r" class="ed-label">Results</h2>
      <ul>
        {results.map((r) => (
          <li>
            <span class="ed-fig">{r.figure}</span>
            <span class="ed-cap">{r.plain}</span>
            <span class="ed-where">{r.where.split(' · ')[0]}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="ed-exp" aria-labelledby="ed-e">
      <h2 id="ed-e" class="ed-label">Experience</h2>
      <ol>
        {featured.map((j) => (
          <li class="ed-job">
            <p class="ed-dates">{j.dates}</p>
            <div>
              <h3>{j.title}<span>, {j.org}</span></h3>
              <ul>{j.ran.slice(0, 3).map((r) => <li>{r}</li>)}</ul>
            </div>
          </li>
        ))}
        {earlier.map((j) => (
          <li class="ed-job ed-job-short">
            <p class="ed-dates">{j.dates}</p>
            <div><h3>{j.title}<span>, {j.org}</span></h3><p>{j.ran[0]}</p></div>
          </li>
        ))}
      </ol>
    </section>

    <section class="ed-skills" aria-labelledby="ed-s">
      <h2 id="ed-s" class="ed-label">What I bring</h2>
      <dl>
        {skills.map((s) => (<div><dt>{s.name}</dt><dd>{s.items}.</dd></div>))}
      </dl>
    </section>

    <section class="ed-started" aria-labelledby="ed-v">
      <h2 id="ed-v" class="ed-label">Things I've started</h2>
      <ul>
        {ventures.map((v) => (
          <li><p class="ed-dates">{v.when}</p><h3>{v.name}</h3><p>{v.pitch}</p></li>
        ))}
      </ul>
    </section>

    <footer class="ed-contact">
      <p class="ed-label">Contact</p>
      <p class="ed-big"><a href={`mailto:${person.email}`}>Let's talk.</a></p>
      <p>{person.email} · {person.phone} · {person.location}</p>
    </footer>
  </div>
</Base>

<style>
  :global(main) { max-width: none; padding: 0; }
  :global(body) { background: #f4efe6; }
  :global(.site-header) { background: #f4efe6; border-image: none; border-bottom: 1px solid #d8cfc1; }
  :global(.brand) { font-family: 'Fraunces Variable', serif; font-weight: 600; }
  :global(.btn-resume) { background: #1b1814; color: #f4efe6; box-shadow: none; transform: none; border-radius: 999px; }
  :global(.btn-resume .r-muted) { color: #cfc6b8; }
  .ed { --ink: #1b1814; --muted: #625a50; --rule: #d8cfc1; --accent: #b4441b; color: var(--ink); font-family: 'Inter Variable', system-ui, sans-serif; max-width: 72rem; margin: 0 auto; padding: 0 1.25rem 4rem; }
  .ed-label { font-size: .78rem; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); font-weight: 600; margin: 0 0 1.5rem; }
  .ed-hero { padding: 4rem 0 3.5rem; border-bottom: 1px solid var(--rule); }
  .ed-kicker { color: var(--muted); font-size: .95rem; margin: 0 0 1.5rem; }
  .ed-name { font-family: 'Fraunces Variable', serif; font-weight: 600; font-variation-settings: 'opsz' 144, 'SOFT' 50; font-size: clamp(3.6rem, 13vw, 9.5rem); line-height: .9; letter-spacing: -.035em; margin: 0; }
  .ed-line { font-family: 'Fraunces Variable', serif; font-size: clamp(1.6rem, 4.4vw, 3rem); line-height: 1.1; margin: .5rem 0 2.5rem; color: var(--accent); }
  .ed-hero-grid { display: grid; gap: 2rem; }
  @media (min-width: 860px) { .ed-hero-grid { grid-template-columns: 1.4fr 1fr; align-items: end; } }
  .ed-lede { font-size: 1.2rem; line-height: 1.6; margin: 0; max-width: 36rem; }
  .ed-actions { display: flex; flex-wrap: wrap; gap: .75rem 1.25rem; align-items: center; }
  .ed-btn { background: var(--ink); color: #f4efe6; padding: .9rem 1.4rem; border-radius: 999px; text-decoration: none; font-weight: 600; }
  .ed-link { color: var(--ink); font-weight: 600; text-underline-offset: 4px; }
  .ed-results { padding: 3.5rem 0; border-bottom: 1px solid var(--rule); }
  .ed-results ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 2rem; }
  .ed-results li { display: grid; gap: .5rem; border-top: 2px solid var(--ink); padding-top: 1rem; }
  .ed-fig { font-family: 'Fraunces Variable', serif; font-size: clamp(2.6rem, 6vw, 3.6rem); font-weight: 500; line-height: 1; letter-spacing: -.02em; }
  .ed-cap { line-height: 1.45; }
  .ed-where { color: var(--muted); font-size: .9rem; }
  .ed-exp, .ed-skills, .ed-started { padding: 3.5rem 0; border-bottom: 1px solid var(--rule); }
  .ed-exp ol { list-style: none; margin: 0; padding: 0; }
  .ed-job { display: grid; gap: .25rem 2rem; padding: 1.5rem 0; border-top: 1px solid var(--rule); }
  @media (min-width: 760px) { .ed-job { grid-template-columns: 12rem 1fr; } }
  .ed-dates { color: var(--muted); font-size: .92rem; margin: .2rem 0 0; font-variant-numeric: tabular-nums; }
  .ed-job h3 { font-family: 'Fraunces Variable', serif; font-weight: 600; font-size: 1.5rem; margin: 0 0 .5rem; }
  .ed-job h3 span { font-weight: 400; color: var(--muted); }
  .ed-job ul { margin: 0; padding-left: 1.1rem; line-height: 1.55; }
  .ed-job-short p { margin: 0; color: var(--muted); }
  .ed-job-short h3 { font-size: 1.2rem; margin-bottom: .25rem; }
  .ed-skills dl { margin: 0; display: grid; gap: 1.5rem 3rem; }
  @media (min-width: 760px) { .ed-skills dl { grid-template-columns: 1fr 1fr; } }
  .ed-skills dt { font-family: 'Fraunces Variable', serif; font-size: 1.4rem; font-weight: 600; }
  .ed-skills dd { margin: .25rem 0 0; color: var(--muted); line-height: 1.55; }
  .ed-started ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 2rem; }
  .ed-started h3 { font-family: 'Fraunces Variable', serif; font-size: 1.6rem; margin: .25rem 0 .4rem; }
  .ed-started p { margin: 0; line-height: 1.5; }
  .ed-contact { padding: 4rem 0 0; }
  .ed-big { font-family: 'Fraunces Variable', serif; font-size: clamp(3rem, 10vw, 7rem); line-height: 1; margin: 0 0 1rem; letter-spacing: -.03em; }
  .ed-big a { color: var(--accent); text-decoration: none; }
  .ed-big a:hover { text-decoration: underline; text-decoration-thickness: 4px; }
  .ed-contact p:last-child { color: var(--muted); }
</style>
