---
// Option 3: in the style of human-md.ai. Saturated cobalt, pink and cream; huge type; markdown-style labels.
import Base from '../../layouts/Base.astro';
import { person, results, jobs, ventures, principles, skills } from '../../data/aaron';
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource/instrument-serif';
import '@fontsource/ibm-plex-mono';
---
<Base title="Option 3 · Aaron Adams" noindex chrome={false}>
  <div class="o3">
    <header class="o3-nav">
      <a class="o3-brand" href="#top">AARON ADAMS<span class="o3-dot" aria-hidden="true"></span></a>
      <a class="o3-navlink" href={`mailto:${person.email}`}>email</a>
      <a class="o3-pill" href={person.resumePdf} download>resume <span aria-hidden="true">↓</span></a>
    </header>

    <section id="top" class="o3-hero o3-blue" aria-labelledby="o3-h">
      <h1 id="o3-h" class="o3-logo"><span class="o3-sans">AARON</span><span class="o3-dot o3-dot-big" aria-hidden="true"></span><span class="o3-serif">adams</span></h1>
      <div class="o3-terminal">
        <p><span aria-hidden="true">&gt;</span> runs operations, programs and teams.</p>
        <p><span aria-hidden="true">&gt;</span> based in the atlanta metro, ga.</p>
        <p><span aria-hidden="true">&gt;</span> currently running nxt and building mobili.</p>
      </div>
      <div class="o3-corners" aria-hidden="true"><span>AARON ADAMS</span><span>NOV 2026</span></div>
    </section>

    <section class="o3-blue o3-sec" aria-labelledby="o3-what">
      <h2 class="o3-md" id="o3-what"><span aria-hidden="true">## </span>what I do</h2>
      <p class="o3-statement">{person.positioning}</p>
      <p class="o3-giant o3-giant-pink" aria-hidden="true">operations</p>
    </section>

    <section class="o3-pink o3-sec" aria-labelledby="o3-n">
      <h2 class="o3-md" id="o3-n"><span aria-hidden="true">## </span>the numbers</h2>
      <ul class="o3-nums">
        {results.map((r) => (<li><span class="o3-num">{r.figure}</span><span class="o3-num-cap">{r.plain}</span><span class="o3-mono">{r.where.split(' · ')[0].toLowerCase()}</span></li>))}
      </ul>
    </section>

    <section class="o3-cream o3-sec" aria-labelledby="o3-w">
      <h2 class="o3-md" id="o3-w"><span aria-hidden="true">## </span>where I've worked</h2>
      <ol class="o3-jobs">
        {jobs.map((j) => (
          <li>
            <details>
              <summary>
                <span class="o3-mono o3-jd">{j.dates.toLowerCase()}</span>
                <span class="o3-jorg">{j.org}</span>
                <span class="o3-jt">{j.title}</span>
              </summary>
              <ul>{j.ran.map((r) => <li>{r}</li>)}</ul>
            </details>
          </li>
        ))}
      </ol>
    </section>

    <section class="o3-blue o3-sec" aria-labelledby="o3-b">
      <h2 class="o3-md" id="o3-b"><span aria-hidden="true">## </span>what I actually bring to the table</h2>
      <ul class="o3-bring">
        {skills.map((s) => (<li><h3>{s.name.toLowerCase()}</h3><p>{s.items}.</p><p class="o3-mono o3-proof">&gt; {s.proof.toLowerCase()}</p></li>))}
      </ul>
    </section>

    <section class="o3-cream o3-sec" aria-labelledby="o3-v">
      <h2 class="o3-md" id="o3-v"><span aria-hidden="true">## </span>things I've started</h2>
      <ul class="o3-ventures">
        {ventures.map((v, i) => (
          <li class={`o3-v o3-v-${i}`}>
            <span class="o3-mono">{v.when.toLowerCase()} · {v.status}</span>
            <h3>{v.name}</h3>
            <p>{v.pitch}</p>
            {v.url && <a href={v.url} rel="noopener">{v.url.replace('https://www.', '')} <span aria-hidden="true">↗</span></a>}
          </li>
        ))}
      </ul>
    </section>

    <section class="o3-pink o3-sec" aria-labelledby="o3-how">
      <h2 class="o3-md" id="o3-how"><span aria-hidden="true">## </span>how I work</h2>
      <ol class="o3-how">
        {principles.map((p, i) => (<li><span class="o3-mono o3-hn">0{i + 1}</span><div><p class="o3-hl">{p.line}</p><p class="o3-hp">{p.proof}</p></div></li>))}
      </ol>
    </section>

    <section class="o3-blue o3-sec o3-end" aria-labelledby="o3-c">
      <h2 class="o3-md"><span aria-hidden="true">## </span>say hi</h2>
      <p id="o3-c" class="o3-giant o3-giant-cream">let's talk<span class="o3-dot o3-dot-big" aria-hidden="true"></span></p>
      <div class="o3-contact">
        <a class="o3-pill o3-pill-lg" href={`mailto:${person.email}`}>{person.email}</a>
        <a class="o3-pill o3-pill-lg o3-pill-ghost" href={person.phoneHref}>{person.phone}</a>
        <a class="o3-pill o3-pill-lg o3-pill-ghost" href={person.linkedin} rel="noopener">linkedin</a>
      </div>
      <div class="o3-corners o3-corners-static"><span>AARON ADAMS · {person.location.toUpperCase()}</span><a href="/resume">PLAIN-TEXT RESUME</a></div>
    </section>
  </div>
</Base>

<style>
  :global(body) { background: #1240d6; }
  .o3 { --blue: #1240d6; --pink: #f7a9c6; --cream: #f4efe8; --ink: #201e1f; --red: #ff4b1f;
    font-family: 'Bricolage Grotesque Variable', system-ui, sans-serif; color: var(--cream); font-weight: 300; font-size: 1.0625rem; line-height: 1.55; }
  .o3 a { color: inherit; }
  .o3-mono { font-family: 'IBM Plex Mono', monospace; font-size: .8rem; letter-spacing: .08em; }
  .o3-blue { background: var(--blue); color: var(--cream); }
  .o3-pink { background: var(--pink); color: var(--ink); }
  .o3-cream { background: var(--cream); color: var(--ink); }
  .o3-sec { padding: 4.5rem 1.25rem 5rem; }
  @media (min-width: 900px) { .o3-sec { padding: 6rem 2.5rem 7rem; } }

  .o3-nav { position: fixed; top: 0; left: 0; right: 0; z-index: 30; display: flex; align-items: center; gap: 1.25rem; padding: 1rem 1.25rem; mix-blend-mode: normal; }
  @media (min-width: 900px) { .o3-nav { padding: 1.5rem 2.5rem; } }
  .o3-brand { white-space: nowrap; display: inline-flex; align-items: flex-start; gap: .2rem; font-weight: 700; font-size: .95rem; text-decoration: none; margin-right: auto; color: var(--cream); background: var(--blue); padding: .3rem .5rem; border-radius: 6px; }
  .o3-dot { display: inline-block; width: .45rem; height: .45rem; border-radius: 50%; background: var(--red); }
  .o3-navlink { font-weight: 600; text-decoration: none; color: var(--cream); background: var(--blue); padding: .3rem .5rem; border-radius: 6px; }
  .o3-pill { display: inline-flex; align-items: center; gap: .5rem; background: var(--pink); color: var(--ink) !important; font-weight: 600; text-decoration: none; border-radius: 999px; padding: .6rem 1.15rem; }

  .o3-hero { position: relative; min-height: 100svh; display: grid; align-content: center; justify-items: center; padding: 6rem 1.25rem 7rem; overflow: hidden; }
  .o3-logo { margin: 0; display: flex; align-items: baseline; flex-wrap: wrap; justify-content: center; line-height: .85; }
  .o3-sans { font-weight: 800; font-size: clamp(4.2rem, 17vw, 13rem); letter-spacing: -.055em; }
  .o3-serif { font-family: 'Instrument Serif', serif; font-weight: 400; font-size: clamp(4.2rem, 16vw, 12rem); letter-spacing: -.02em; margin-left: .05em; }
  .o3-dot-big { width: clamp(.9rem, 2.6vw, 1.9rem); height: clamp(.9rem, 2.6vw, 1.9rem); align-self: flex-start; margin: .3em 0 0 .05em; }
  .o3-terminal { margin-top: 3rem; font-family: 'IBM Plex Mono', monospace; font-size: .9rem; letter-spacing: .12em; display: grid; gap: .4rem; }
  .o3-terminal p { margin: 0; }
  @media (max-width: 560px) { .o3-terminal { letter-spacing: .04em; font-size: .85rem; } }
  .o3-terminal span { color: var(--red); margin-right: .9rem; }
  .o3-corners { position: absolute; left: 1.25rem; right: 1.25rem; bottom: 1.5rem; display: flex; justify-content: space-between; font-family: 'IBM Plex Mono', monospace; font-size: .75rem; letter-spacing: .2em; }
  .o3-corners-static { position: static; margin-top: 5rem; flex-wrap: wrap; gap: 1rem; }
  .o3-corners a { text-decoration: none; }
  .o3-corners a:hover { text-decoration: underline; }

  .o3-md { margin: 0 0 1.75rem; font-weight: 700; font-size: 1rem; }
  .o3-md span { opacity: .55; }
  .o3-statement { margin: 0; font-size: clamp(1.9rem, 4.8vw, 3.6rem); line-height: 1.12; letter-spacing: -.025em; max-width: 52rem; font-weight: 300; }
  .o3-giant { margin: 3rem 0 0; font-weight: 800; font-size: clamp(4rem, 17vw, 15rem); line-height: .85; letter-spacing: -.06em; overflow-wrap: anywhere; }
  .o3-giant-pink { color: var(--pink); }
  .o3-giant-cream { color: var(--cream); margin-top: 0; display: flex; align-items: flex-start; }

  .o3-nums { list-style: none; margin: 0; padding: 0; display: grid; gap: 3rem 2rem; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }
  .o3-nums li { display: grid; gap: .6rem; }
  .o3-num { font-weight: 800; font-size: clamp(3rem, 6vw, 4.6rem); letter-spacing: -.05em; line-height: .9; }
  .o3-num-cap { font-size: 1.15rem; font-weight: 400; max-width: 18rem; }

  .o3-jobs { list-style: none; margin: 0; padding: 0; border-top: 1.5px solid var(--ink); }
  .o3-jobs > li { border-bottom: 1.5px solid var(--ink); }
  .o3-jobs summary { list-style: none; cursor: pointer; display: grid; gap: .2rem 2rem; padding: 1.4rem 0; align-items: baseline; }
  .o3-jobs summary::-webkit-details-marker { display: none; }
  @media (min-width: 900px) { .o3-jobs summary { grid-template-columns: 14rem 1fr auto; } }
  .o3-jorg { font-weight: 700; font-size: clamp(1.7rem, 4.2vw, 3rem); letter-spacing: -.035em; line-height: 1; }
  .o3-jobs summary:hover .o3-jorg { color: var(--blue); }
  .o3-jt { font-size: 1.05rem; font-weight: 400; }
  .o3-jobs ul { margin: 0 0 1.5rem; padding-left: 1.1rem; max-width: 44rem; font-weight: 400; }
  @media (min-width: 900px) { .o3-jobs ul { margin-left: 16rem; } }

  .o3-bring { list-style: none; margin: 0; padding: 0; display: grid; gap: 2.5rem 3rem; }
  @media (min-width: 900px) { .o3-bring { grid-template-columns: 1fr 1fr; } }
  .o3-bring h3 { margin: 0 0 .4rem; font-weight: 700; font-size: clamp(1.8rem, 3.6vw, 2.6rem); letter-spacing: -.035em; color: var(--pink); }
  .o3-bring p { margin: 0; max-width: 32rem; }
  .o3-proof { margin-top: .8rem !important; letter-spacing: .04em; line-height: 1.6; }

  .o3-ventures { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }
  .o3-v { border-radius: 22px; padding: 1.6rem 1.5rem 1.75rem; display: flex; flex-direction: column; gap: .6rem; min-height: 17rem; }
  .o3-v-0 { background: var(--blue); color: var(--cream); } .o3-v-1 { background: var(--ink); color: var(--cream); } .o3-v-2 { background: var(--pink); color: var(--ink); }
  .o3-v h3 { margin: auto 0 0; font-weight: 800; font-size: 2.4rem; letter-spacing: -.045em; line-height: 1; }
  .o3-v p { margin: 0; font-weight: 400; }
  .o3-v a { font-weight: 600; text-underline-offset: 4px; }

  .o3-how { list-style: none; margin: 0; padding: 0; display: grid; gap: 2rem; max-width: 60rem; }
  .o3-how li { display: grid; grid-template-columns: 3rem 1fr; gap: 1rem; }
  .o3-hn { padding-top: .7rem; }
  .o3-how p { margin: 0; }
  .o3-hl { font-size: clamp(1.7rem, 4vw, 2.9rem); line-height: 1.05; letter-spacing: -.03em; font-weight: 600; }
  .o3-hp { margin-top: .5rem !important; font-weight: 400; max-width: 40rem; }

  .o3-end { padding-bottom: 2.5rem; }
  .o3-contact { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2.5rem; }
  .o3-pill-lg { font-size: clamp(1rem, 2.6vw, 1.3rem); padding: .9rem 1.5rem; overflow-wrap: anywhere; }
  .o3-pill-ghost { background: transparent; color: var(--cream) !important; box-shadow: inset 0 0 0 1.5px var(--cream); }
</style>
