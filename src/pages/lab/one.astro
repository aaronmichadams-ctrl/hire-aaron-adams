---
// Option 1: in the style of rentmobili.com. Navy ink, soft blue-gray sections, rounded cards, pill buttons.
import Base from '../../layouts/Base.astro';
import { person, board, results, jobs, skills, ventures, principles } from '../../data/aaron';
import '@fontsource-variable/outfit';
---
<Base title="Option 1 · Aaron Adams" noindex chrome={false}>
  <div class="o1">
    <p class="o1-strip">Open to operations, program management, growth and general management roles. <a href={person.resumePdf} download>Download my resume</a></p>
    <header class="o1-nav">
      <a class="o1-logo" href="#top" aria-label="Aaron Adams, top of page"><span class="o1-mark" aria-hidden="true"><i></i><i></i></span>aaron adams</a>
      <nav aria-label="Sections" class="o1-links">
        <a href="#work">Experience</a><a href="#results">Results</a><a href="#started">Ventures</a><a href="#contact">Contact</a>
      </nav>
      <span class="o1-pill-loc"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-6.3 7-11.5A7 7 0 0 0 5 9.5C5 14.7 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.4"/></svg>Atlanta <span class="o1-tag">Metro</span></span>
      <a class="o1-cta-soft" href={person.resumePdf} download>Resume</a>
    </header>

    <section id="top" class="o1-hero" aria-labelledby="o1-h">
      <div class="o1-hero-copy">
        <p class="o1-kicker">Operations · Programs · Teams</p>
        <h1 id="o1-h">Need it run well? I build and run operations.</h1>
        <p class="o1-lede">I'm Aaron Adams. {person.positioning.replace('I build and run the operations that keep a business moving: ', 'I keep businesses moving: ')}</p>
        <div class="o1-actions">
          <a class="o1-btn" href={`mailto:${person.email}`}>Email me <span aria-hidden="true">→</span></a>
          <a class="o1-btn o1-btn-line" href={person.resumePdf} download>Download resume</a>
        </div>
        <ul class="o1-ticks">
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l4 4 10-10"/></svg>Built NXT from an idea to profitable in year one</li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l4 4 10-10"/></svg>Teams of 10+ in high-volume operations</li>
        </ul>
      </div>
      <div class="o1-hero-art" aria-hidden="true">
        <div class="o1-art-card o1-art-a"><span>+110%</span><small>enrollment in one week</small></div>
        <div class="o1-art-card o1-art-b"><span>125,000+</span><small>inventory items tracked</small></div>
        <div class="o1-art-card o1-art-c"><span>1,100+</span><small>participants run</small></div>
        <div class="o1-art-badge">Founder &amp; Operator, NXT</div>
      </div>
    </section>

    <section class="o1-facts" aria-label="Quick facts">
      <div><p class="o1-fl">Based in</p><p>{person.location}</p></div>
      <div><p class="o1-fl">Right now</p><p>Running NXT · Building Mobili</p></div>
      <div><p class="o1-fl">Phone</p><p><a href={person.phoneHref}>{person.phone}</a></p></div>
      <a class="o1-facts-btn" href={person.linkedin} rel="noopener">LinkedIn</a>
    </section>

    <section id="results" class="o1-band" aria-labelledby="o1-r">
      <div class="o1-wrap">
        <h2 id="o1-r" class="o1-h2">By the numbers</h2>
        <p class="o1-sub">Real results from real jobs.</p>
        <ul class="o1-stats">
          {results.map((r) => (
            <li><span class="o1-stat">{r.figure}</span><span>{r.plain}</span><span class="o1-meta">{r.where.split(' · ')[0]}</span></li>
          ))}
        </ul>
      </div>
    </section>

    <section id="work" class="o1-wrap o1-sec" aria-labelledby="o1-w">
      <div class="o1-head"><div><h2 id="o1-w" class="o1-h2">Where I've worked</h2><p class="o1-sub">Six roles since 2018. Kitchens, warehouses, camps, a pro club and my own company.</p></div><a class="o1-seeall" href="/resume">Full resume</a></div>
      <ul class="o1-jobs">
        {jobs.map((j) => (
          <li class="o1-job">
            <div class="o1-job-top">
              <span class={`o1-chip ${!j.end ? 'o1-chip-now' : ''}`}>{!j.end ? 'Current' : j.dates.split(' to ')[0].replace(/^[A-Za-z]+ /, '')}</span>
            </div>
            <h3>{j.org}</h3>
            <p class="o1-meta">{j.title} · {j.dates}</p>
            <p>{j.summary}</p>
            <details>
              <summary>What I ran</summary>
              <ul>{j.ran.map((r) => <li>{r}</li>)}</ul>
            </details>
          </li>
        ))}
      </ul>
    </section>

    <section class="o1-wrap o1-sec" aria-labelledby="o1-b">
      <h2 id="o1-b" class="o1-h2">What I bring</h2>
      <p class="o1-sub">Four things, each with proof.</p>
      <div class="o1-two">
        {[skills.slice(0, 2), skills.slice(2)].map((col) => (
          <div class="o1-panel">
            {col.map((s) => (
              <div class="o1-row">
                <span class="o1-ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12l4 4 10-10"/></svg></span>
                <div><h3>{s.name}</h3><p>{s.items}.</p><p class="o1-proof">{s.proof}</p></div>
              </div>
            ))}
          </div>
        ))}
      </div>
    </section>

    <section id="started" class="o1-wrap o1-sec" aria-labelledby="o1-v">
      <h2 id="o1-v" class="o1-h2">{board.startedHeading}</h2>
      <p class="o1-sub">{board.startedIntro}</p>
      <ul class="o1-ventures">
        {ventures.map((v, i) => (
          <li class="o1-venture">
            <div class={`o1-v-art o1-v-art-${i}`} aria-hidden="true"><span>{v.name.slice(0, 1)}</span><em class="o1-chip o1-chip-float">{v.status}</em></div>
            <h3>{v.name}</h3>
            <p class="o1-meta">{v.when}</p>
            <p>{v.pitch}</p>
            {v.url && <a class="o1-seeall" href={v.url} rel="noopener">Visit {v.url.replace('https://www.', '')}</a>}
          </li>
        ))}
      </ul>
    </section>

    <section class="o1-wrap o1-sec" aria-labelledby="o1-how">
      <h2 id="o1-how" class="o1-h2">How I work</h2>
      <ul class="o1-trust">
        {principles.map((p) => (<li><h3>{p.line}</h3><p>{p.proof}</p></li>))}
      </ul>
    </section>

    <section id="contact" class="o1-wrap o1-sec" aria-labelledby="o1-c">
      <div class="o1-dark">
        <h2 id="o1-c">Hiring for operations, programs or growth?</h2>
        <p>{board.contactIntro.replace('Hiring for operations, programs or growth? ', '')}</p>
        <div class="o1-actions">
          <a class="o1-btn o1-btn-white" href={`mailto:${person.email}`}>{person.email}</a>
          <a class="o1-btn-text" href={person.phoneHref}>{person.phone}</a>
        </div>
      </div>
    </section>

    <footer class="o1-foot">
      <div class="o1-wrap o1-foot-grid">
        <div><p class="o1-logo o1-logo-w"><span class="o1-mark" aria-hidden="true"><i></i><i></i></span>aaron adams</p><p>Operations, programs and teams. {person.location}.</p></div>
        <div><p class="o1-fh">Contact</p><a href={`mailto:${person.email}`}>Email</a><a href={person.phoneHref}>Phone</a><a href={person.linkedin} rel="noopener">LinkedIn</a></div>
        <div><p class="o1-fh">Resume</p><a href={person.resumePdf} download>Download PDF</a><a href="/resume">Plain text</a></div>
      </div>
    </footer>
  </div>
</Base>

<style>
  :global(body) { background: #fff; }
  .o1 { --navy: #1f2a44; --ink2: #4a5568; --muted: #64708a; --line: #e3e8ef; --soft: #f3f6fa; --sky: #dcecff; --pink: #f6b3c4; --blue: #9cc8ff;
    font-family: 'Outfit Variable', system-ui, sans-serif; color: var(--navy); font-size: 1.0625rem; line-height: 1.6; }
  .o1 a { color: inherit; }
  .o1-wrap { max-width: 75rem; margin: 0 auto; padding: 0 1.25rem; }
  .o1-strip { margin: 0; background: var(--navy); color: #fff; text-align: center; font-size: .875rem; padding: .55rem 1rem; }
  .o1-strip a { font-weight: 600; text-underline-offset: 3px; margin-left: .4rem; }
  .o1-nav { position: sticky; top: 0; z-index: 30; display: flex; align-items: center; gap: 1.5rem; padding: .85rem max(1.25rem, calc((100% - 72.5rem) / 2)); background: rgba(255,255,255,.95); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  .o1-logo { display: inline-flex; align-items: center; gap: .5rem; font-weight: 700; font-size: 1.4rem; letter-spacing: -.03em; text-decoration: none; margin: 0; }
  .o1-mark { display: inline-flex; gap: 2px; }
  .o1-mark i { width: .8rem; height: .65rem; border-radius: .4rem .4rem .15rem .15rem; background: var(--blue); }
  .o1-mark i + i { background: var(--pink); }
  .o1-links { display: none; gap: 1.5rem; }
  .o1-links a { text-decoration: none; color: var(--ink2); }
  .o1-links a:hover { color: var(--navy); }
  .o1-pill-loc { display: none; margin-left: auto; align-items: center; gap: .4rem; border: 1px solid #cfd6e1; border-radius: 999px; padding: .4rem .9rem; font-size: .95rem; }
  .o1-pill-loc svg, .o1-ticks svg, .o1-ico svg { width: 1.05rem; height: 1.05rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .o1-tag { font-size: .72rem; font-weight: 600; background: var(--soft); border-radius: 6px; padding: 0 .35rem; }
  .o1-cta-soft { margin-left: auto; background: var(--sky); border: 1px solid #b9d7fb; border-radius: 999px; padding: .5rem 1.1rem; font-weight: 600; text-decoration: none; }
  @media (min-width: 900px) { .o1-links { display: flex; } .o1-pill-loc { display: inline-flex; } .o1-cta-soft { margin-left: 0; } }

  .o1-hero { max-width: 75rem; margin: 0 auto; padding: 3rem 1.25rem 2rem; display: grid; gap: 2.5rem; }
  @media (min-width: 960px) { .o1-hero { grid-template-columns: 1fr 1fr; align-items: center; padding-top: 4.5rem; } }
  .o1-kicker { margin: 0 0 .75rem; font-size: .8rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--ink2); }
  .o1-hero h1 { font-size: clamp(2.4rem, 6vw, 3.6rem); line-height: 1.06; letter-spacing: -.025em; font-weight: 600; margin: 0 0 1.1rem; }
  .o1-lede { color: var(--ink2); margin: 0 0 1.75rem; max-width: 34rem; line-height: 1.75; }
  .o1-actions { display: flex; flex-wrap: wrap; gap: .75rem; align-items: center; }
  .o1-btn { display: inline-flex; align-items: center; gap: .5rem; min-height: 3.1rem; padding: 0 1.6rem; border-radius: 999px; background: var(--navy); color: #fff !important; font-weight: 600; text-decoration: none; }
  .o1-btn-line { background: #fff; color: var(--navy) !important; border: 1px solid #cfd6e1; }
  .o1-btn-white { background: #fff; color: var(--navy) !important; overflow-wrap: anywhere; }
  .o1-btn-text { color: #fff !important; font-weight: 600; }
  .o1-ticks { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; gap: .4rem; color: var(--ink2); font-size: .95rem; }
  .o1-ticks li { display: flex; gap: .5rem; align-items: center; }
  .o1-hero-art { position: relative; aspect-ratio: 5 / 4; border-radius: 22px; background: linear-gradient(160deg, #eaf3ff, #fbe9ee); overflow: hidden; min-height: 18rem; }
  .o1-art-card { position: absolute; background: #fff; border-radius: 16px; padding: 1rem 1.2rem; box-shadow: 0 12px 30px -12px rgba(31,42,68,.28); display: grid; }
  .o1-art-card span { font-size: clamp(1.6rem, 3.4vw, 2.3rem); font-weight: 700; letter-spacing: -.03em; line-height: 1.1; }
  .o1-art-card small { color: var(--muted); font-size: .85rem; }
  .o1-art-a { left: 8%; top: 12%; } .o1-art-b { right: 7%; top: 38%; } .o1-art-c { left: 16%; bottom: 10%; }
  .o1-art-badge { position: absolute; right: 8%; bottom: 12%; background: var(--navy); color: #fff; border-radius: 999px; padding: .4rem .9rem; font-size: .85rem; font-weight: 600; }

  .o1-facts { max-width: 72.5rem; margin: 0 1.25rem 3.5rem; border: 1px solid #cfd6e1; border-radius: 20px; display: grid; overflow: hidden; }
  @media (min-width: 75rem) { .o1-facts { margin: 0 auto 3.5rem; } }
  .o1-facts > div { padding: .9rem 1.3rem; border-bottom: 1px solid var(--line); }
  .o1-facts p { margin: 0; }
  .o1-fl { font-size: .72rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .o1-facts-btn { margin: .75rem; justify-self: start; background: var(--navy); color: #fff !important; border-radius: 999px; padding: .75rem 1.5rem; font-weight: 600; text-decoration: none; }
  @media (min-width: 860px) { .o1-facts { grid-template-columns: 1fr 1fr 1fr auto; align-items: center; border-radius: 999px; } .o1-facts > div { border-bottom: 0; border-right: 1px solid var(--line); padding-left: 1.75rem; } .o1-facts-btn { margin: .5rem; } }

  .o1-band { background: var(--soft); padding: 3.5rem 0; }
  .o1-sec { padding-top: 3.5rem; padding-bottom: 1rem; }
  .o1-h2 { font-size: clamp(1.6rem, 3.4vw, 1.9rem); font-weight: 600; letter-spacing: -.015em; margin: 0; line-height: 1.2; }
  .o1-sub { margin: .2rem 0 1.75rem; color: var(--muted); }
  .o1-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; flex-wrap: wrap; }
  .o1-seeall { font-weight: 600; font-size: .95rem; text-underline-offset: 3px; }
  .o1-head .o1-seeall { margin-bottom: 1.75rem; }
  .o1-stats { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); }
  .o1-stats li { background: #fff; border-radius: 18px; padding: 1.4rem; display: grid; gap: .35rem; border: 1px solid var(--line); }
  .o1-stat { font-size: 2.4rem; font-weight: 700; letter-spacing: -.035em; line-height: 1.05; }
  .o1-meta { color: var(--muted); font-size: .9rem; margin: 0; }

  .o1-jobs { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); }
  .o1-job { border: 1px solid var(--line); border-radius: 18px; padding: 1.25rem; display: flex; flex-direction: column; gap: .3rem; }
  .o1-job h3 { margin: .4rem 0 0; font-size: 1.2rem; font-weight: 600; }
  .o1-job p { margin: 0; }
  .o1-job details { margin-top: .6rem; font-size: .95rem; }
  .o1-job summary { cursor: pointer; font-weight: 600; min-height: 2.75rem; display: flex; align-items: center; }
  .o1-job details ul { margin: 0; padding-left: 1.1rem; color: var(--ink2); }
  .o1-chip { display: inline-block; font-size: .78rem; font-weight: 600; background: var(--soft); border-radius: 999px; padding: .15rem .65rem; font-style: normal; }
  .o1-chip-now { background: #fde6ec; color: #8a1f3d; }

  .o1-two { display: grid; gap: 1.25rem; }
  @media (min-width: 860px) { .o1-two { grid-template-columns: 1fr 1fr; } }
  .o1-panel { border: 1px solid var(--line); border-radius: 18px; padding: .5rem 1.5rem; }
  .o1-row { display: grid; grid-template-columns: 2.25rem 1fr; gap: .75rem; padding: 1.1rem 0; }
  .o1-row + .o1-row { border-top: 1px solid var(--line); }
  .o1-ico { width: 2.25rem; height: 2.25rem; border-radius: 10px; background: var(--soft); display: grid; place-items: center; }
  .o1-row h3 { margin: 0; font-size: 1.1rem; font-weight: 600; }
  .o1-row p { margin: .15rem 0 0; color: var(--ink2); }
  .o1-row .o1-proof { color: var(--navy); font-weight: 500; }

  .o1-ventures { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }
  .o1-venture h3 { margin: .8rem 0 0; font-size: 1.2rem; font-weight: 600; }
  .o1-venture p { margin: .2rem 0 .3rem; }
  .o1-v-art { position: relative; aspect-ratio: 4 / 3; border-radius: 16px; display: grid; place-items: center; }
  .o1-v-art span { font-size: 4.5rem; font-weight: 700; color: rgba(31,42,68,.85); letter-spacing: -.05em; }
  .o1-v-art-0 { background: #e6f1ff; } .o1-v-art-1 { background: #e9f7ee; } .o1-v-art-2 { background: #fde9ee; }
  .o1-chip-float { position: absolute; left: .75rem; top: .75rem; background: #fff; }

  .o1-trust { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); }
  .o1-trust h3 { margin: 0 0 .3rem; font-size: 1.05rem; font-weight: 600; }
  .o1-trust p { margin: 0; color: var(--muted); font-size: .95rem; }

  .o1-dark { background: var(--navy); color: #fff; border-radius: 24px; padding: 2.5rem 1.75rem; margin: 1.5rem 0 4rem; }
  @media (min-width: 760px) { .o1-dark { padding: 3.5rem; } }
  .o1-dark h2 { margin: 0 0 .6rem; font-size: clamp(1.8rem, 4.5vw, 2.6rem); line-height: 1.12; font-weight: 600; letter-spacing: -.02em; max-width: 30rem; }
  .o1-dark p { color: #c9d1e0; margin: 0 0 1.75rem; max-width: 32rem; }
  .o1-foot { background: var(--navy); color: #c9d1e0; padding: 3rem 0; font-size: .95rem; }
  .o1-foot-grid { display: grid; gap: 2rem; }
  @media (min-width: 760px) { .o1-foot-grid { grid-template-columns: 2fr 1fr 1fr; } }
  .o1-foot a { display: block; color: #fff; text-decoration: none; margin: .3rem 0; }
  .o1-foot a:hover { text-decoration: underline; }
  .o1-logo-w { color: #fff; }
  .o1-fh { color: #fff; font-weight: 600; margin: 0 0 .5rem; }
</style>
