---
import Base from '../layouts/Base.astro';
---
<Base title="Not found · Aaron Adams" description="This page doesn't exist." noindex>
  <div class="nf">
    <div class="nf-card">
      <p class="nf-k">404</p>
      <h1>Offside. This page doesn't exist.</h1>
      <p>Everything else is still on the profile.</p>
      <p class="nf-links"><a href="/">Back to the profile</a><a href="/resume">Plain-text resume</a></p>
    </div>
  </div>
</Base>
<style>
  .nf { max-width: 40rem; margin: 0 auto; padding: 12vh 1rem; }
  .nf-card { background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 2rem 1.5rem; }
  .nf-k { margin: 0; color: var(--team); font-weight: 700; }
  h1 { font-size: clamp(1.6rem, 5vw, 2.2rem); line-height: 1.1; margin: .4rem 0 .75rem; }
  .nf-links { display: flex; gap: 1.25rem; font-weight: 600; }
</style>
