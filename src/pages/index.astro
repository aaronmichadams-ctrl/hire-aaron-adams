---
/**
 * The profile page. Laid out like a football player profile: a colored band,
 * an attribute grid, positions on a pitch, highlights, strengths, and a career
 * list with the current club and former clubs. All words come from src/data/aaron.ts.
 */
import Base from '../layouts/Base.astro';
import ResumeView from '../components/ResumeView.astro';
import { person, results, jobs, skills, ventures, education, principles, positions, board } from '../data/aaron';

const initials = (s: string) => s.split(/\s+/).filter((w) => /[A-Za-z]/.test(w[0])).slice(0, 2).map((w) => w[0]).join('').toUpperCase();
const firstYear = Number(jobs[jobs.length - 1].start.slice(0, 4));
const yearsIn = 2026 - firstYear;
const crest: Record<string, string> = { nxt: '#c8102e', atlutd: '#111111', winshape: '#1d6fd8', copper: '#7a4b2a', chickfila: '#d0102f', myaudiopet: '#5b5bd6' };
const current = jobs.filter((j) => !j.end);
const former = jobs.filter((j) => j.end);
const allPositions = [positions.primary, ...positions.others];
---
<Base>
  <div class="grid no-print">
    <div class="col-main">
      <!-- ============ PROFILE ============ -->
      <section class="card profile o-1" aria-labelledby="name">
        <div class="band">
          <img class="avatar" src={person.photoSmall} srcset={`${person.photoSmall} 160w, ${person.photo} 320w`} sizes="88px" width="88" height="88" alt="Aaron Adams" fetchpriority="high" />
          <div class="band-txt">
            <h1 id="name">{person.name}</h1>
            <p>Operations · Sales · Marketing · Programs</p>
          </div>
          <a class="follow" href={person.resumePdf} download>Download resume</a>
        </div>
        <div class="profile-body">
          <dl class="attrs">
            <div><dt>{person.location.replace(' metro', '')}</dt><dd>Based in</dd></div>
            <div><dt>{yearsIn} years</dt><dd>Experience, since {firstYear}</dd></div>
            <div><dt>{jobs.length}</dt><dd>Roles held</dd></div>
            <div><dt>Founder</dt><dd>NXT, 2023 to now</dd></div>
            <div><dt>B.S. {education.year.slice(-4)}</dt><dd>{education.school}</dd></div>
            <div><dt>Spanish</dt><dd>Studied through level 3</dd></div>
          </dl>

          <div class="position">
            <h2 class="pos-h">Position</h2>
            <div class="pos-list">
              <p class="pos-k">Primary</p>
              <p class="pos-v">{positions.primary.name}</p>
              <p class="pos-k pos-k2">Others</p>
              <ul class="pos-others">
                {positions.others.map((p) => <li>{p.name}</li>)}
              </ul>
            </div>
            <div class="pitch" aria-hidden="true">
              <span class="box box-t"></span><span class="halfway"></span><span class="box box-b"></span>
              {allPositions.map((p, i) => (
                <b class={`chip ${i === 0 ? 'chip-main' : ''}`} style={`left:${p.x}%;top:${p.y}%`}>{p.code}</b>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- ============ HIGHLIGHTS ============ -->
      <section id="highlights" class="card o-2" aria-labelledby="hl-h">
        <h2 id="hl-h" class="card-h">Career highlights</h2>
        <ul class="stats">
          {results.map((r, i) => (
            <li>
              <span class={`num ${i === 1 ? 'num-badge' : ''}`}>{r.figure}</span>
              <span class="lab">{r.plain}</span>
              <span class="src">{r.where.split(' · ')[0]}</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- ============ STRENGTHS ============ -->
      <section class="card o-4" aria-labelledby="st-h">
        <h2 id="st-h" class="card-h">Strengths</h2>
        <ul class="traits">
          {skills.map((s) => (
            <li><p class="trait-h">{s.name}</p><p class="muted">{s.items}</p><p class="trait-p">{s.proof}</p></li>
          ))}
        </ul>
      </section>

      <!-- ============ HOW I PLAY ============ -->
      <section class="card o-6" aria-labelledby="how-h">
        <h2 id="how-h" class="card-h">How I work</h2>
        <ol class="how">
          {principles.map((p, i) => (
            <li><span class="how-n" aria-hidden="true">{i + 1}</span><div><p class="how-l">{p.line}</p><p class="muted">{p.proof}</p></div></li>
          ))}
        </ol>
      </section>
    </div>

    <aside class="col-side">
      <!-- ============ CAREER ============ -->
      <section id="career" class="card o-3" aria-labelledby="car-h">
        <h2 id="car-h" class="card-h">Career</h2>

        <h3 class="group">Current club</h3>
        <ul class="clubs">
          {current.map((j) => (
            <li>
              <details>
                <summary>
                  <span class="crest" style={`--c:${crest[j.id]}`} aria-hidden="true">{initials(j.org)}</span>
                  <span class="club-txt"><strong>{j.org}</strong><span>{j.title}</span><span>{j.dates.replace(' to ', ' - ')}</span></span>
                  <span class="chev" aria-hidden="true">›</span>
                </summary>
                <ul class="club-detail">{j.ran.map((r) => <li>{r}</li>)}</ul>
              </details>
            </li>
          ))}
        </ul>

        <h3 class="group">Former clubs</h3>
        <ul class="clubs">
          {former.map((j) => (
            <li>
              <details>
                <summary>
                  <span class="crest" style={`--c:${crest[j.id]}`} aria-hidden="true">{initials(j.org)}</span>
                  <span class="club-txt"><strong>{j.org}</strong><span>{j.title}</span><span>{j.dates.replace(' to ', ' - ')}</span></span>
                  <span class="chev" aria-hidden="true">›</span>
                </summary>
                <ul class="club-detail">{j.ran.map((r) => <li>{r}</li>)}</ul>
              </details>
            </li>
          ))}
        </ul>
        <p class="card-foot"><a href="/resume">Full resume</a><span>Tap a club for details</span></p>
      </section>

      <!-- ============ VENTURES ============ -->
      <section id="started" class="card o-5" aria-labelledby="v-h">
        <h2 id="v-h" class="card-h">{board.startedHeading}</h2>
        <ul class="trophies">
          {ventures.map((v) => (
            <li>
              <span class="t-when">{v.when}</span>
              <div>
                <strong>{v.name}</strong>
                <p>{v.pitch}</p>
                {v.url && <a href={v.url} rel="noopener">{v.url.replace('https://www.', '')}</a>}
              </div>
            </li>
          ))}
        </ul>
      </section>

      <!-- ============ CONTACT ============ -->
      <section class="card contact o-7" aria-labelledby="c-h">
        <h2 id="c-h" class="card-h">Contact</h2>
        <a class="row-link" href={`mailto:${person.email}`}><span>Email</span><strong>{person.email}</strong></a>
        <a class="row-link" href={person.phoneHref}><span>Phone</span><strong>{person.phone}</strong></a>
        <a class="row-link" href={person.linkedin} rel="noopener"><span>LinkedIn</span><strong>aaron-adams96</strong></a>
        <a class="row-link" href={person.resumePdf} download><span>Resume</span><strong>Download PDF</strong></a>
      </section>
    </aside>
  </div>

  <div class="print-only">
    <ResumeView headingLevel={2} />
  </div>
</Base>

<style>
  .grid { max-width: 80rem; margin: 0 auto; padding: 1rem .75rem 1rem; display: grid; gap: 1rem; }
  @media (min-width: 1000px) { .grid { grid-template-columns: minmax(0, 1fr) 26rem; padding: 1.25rem 1rem 1rem; } }
  .col-main, .col-side { display: grid; gap: 1rem; align-content: start; }
  /* One column on phones and tablets: show career right after the highlights. */
  @media (max-width: 999px) {
    .col-main, .col-side { display: contents; }
    .o-1 { order: 1; } .o-2 { order: 2; } .o-3 { order: 3; } .o-4 { order: 4; } .o-5 { order: 5; } .o-6 { order: 6; } .o-7 { order: 7; }
  }
  .card { background: var(--card); border-radius: 16px; border: 1px solid var(--line); overflow: hidden; }
  .card-h { font-size: 1.15rem; font-weight: 600; margin: 0; padding: 1.4rem 1.5rem 1rem; }
  .muted { color: var(--muted); }

  /* ---------- profile ---------- */
  .band { display: flex; align-items: center; gap: 1rem; background: var(--team); color: #fff; padding: 1.25rem 1.5rem; flex-wrap: wrap; }
  .avatar { width: 5.5rem; height: 5.5rem; border-radius: 50%; background: #fff; object-fit: cover; flex: none; box-shadow: 0 0 0 3px rgba(255,255,255,.9); }
  .band-txt { min-width: 0; }
  .band h1 { margin: 0; font-size: clamp(1.6rem, 4vw, 2rem); font-weight: 600; line-height: 1.1; }
  .band p { margin: .2rem 0 0; font-size: 1.05rem; }
  .follow { margin-left: auto; background: #fff; color: var(--team); border-radius: 999px; padding: .6rem 1.15rem; font-weight: 700; text-decoration: none; }
  .follow:hover { background: #fbeaea; }
  .profile-body { display: grid; }
  @media (min-width: 760px) { .profile-body { grid-template-columns: 1fr 1.05fr; } }
  .attrs { margin: 0; padding: .5rem 1.5rem 1rem; display: grid; grid-template-columns: 1fr 1fr; column-gap: 1.5rem; }
  .attrs div { padding: 1rem 0; border-bottom: 1px solid var(--line); }
  .attrs dt { font-size: 1.05rem; }
  .attrs dd { margin: .1rem 0 0; color: var(--muted); font-size: .88rem; }

  .position { display: grid; grid-template-columns: 1fr auto; gap: 1rem; padding: 1.5rem; border-top: 1px solid var(--line); }
  @media (min-width: 760px) { .position { border-top: 0; border-left: 1px solid var(--line); } }
  .pos-h { grid-column: 1 / -1; font-weight: 600; font-size: 1.05rem; margin: 0; }
  .pos-list p { margin: 0; }
  .pos-k { color: var(--team); font-weight: 600; }
  .pos-k2 { color: var(--muted); margin-top: 1rem !important; }
  .pos-v { margin-top: .15rem !important; }
  .pos-others { list-style: none; margin: .15rem 0 0; padding: 0; display: grid; gap: .15rem; }
  .pitch { position: relative; width: 10rem; height: 14rem; background: #f2f2f2; border-radius: 6px; overflow: hidden; }
  .box { position: absolute; left: 24%; right: 24%; height: 14%; border: 2px solid #fff; }
  .box-t { top: -2px; } .box-b { bottom: -2px; }
  .halfway { position: absolute; left: 0; right: 0; top: 50%; border-top: 2px solid #fff; }
  .halfway::after { content: ''; position: absolute; left: 50%; top: -1.35rem; width: 2.7rem; height: 2.7rem; transform: translateX(-50%); border: 2px solid #fff; border-radius: 50%; }
  .chip { position: absolute; transform: translate(-50%, -50%); font-size: .7rem; font-weight: 700; color: #fff; background: #6b6b6b; padding: .15rem .45rem; border-radius: 999px; white-space: nowrap; }
  .chip-main { background: var(--team); font-size: .78rem; padding: .2rem .55rem; }
  @media (max-width: 400px) { .pitch { width: 8.5rem; height: 12rem; } }

  /* ---------- highlights ---------- */
  .stats { list-style: none; margin: 0; padding: .25rem 1.5rem 1.5rem; display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem 1rem; text-align: center; }
  @media (min-width: 760px) { .stats { grid-template-columns: repeat(4, 1fr); } }
  .stats li { display: grid; gap: .3rem; justify-items: center; align-content: start; }
  .num { font-size: 1.6rem; font-weight: 600; letter-spacing: -.02em; }
  .num-badge { background: var(--green); color: #fff; border-radius: 6px; padding: 0 .5rem; }
  .lab { font-size: .9rem; }
  .src { color: var(--muted); font-size: .8rem; }

  /* ---------- strengths ---------- */
  .traits { list-style: none; margin: 0; padding: 0 1.5rem 1.25rem; display: grid; gap: 0 1.5rem; }
  @media (min-width: 760px) { .traits { grid-template-columns: 1fr 1fr; } }
  .traits li { padding: 1rem 0; border-top: 1px solid var(--line); }
  .traits p { margin: 0; }
  .trait-h { font-weight: 600; font-size: 1.05rem; }
  .trait-p { margin-top: .4rem !important; color: var(--team); font-weight: 600; }

  /* ---------- how I work ---------- */
  .how { list-style: none; margin: 0; padding: 0 1.5rem 1.25rem; }
  .how li { display: grid; grid-template-columns: 2rem 1fr; gap: .75rem; padding: .9rem 0; border-top: 1px solid var(--line); }
  .how p { margin: 0; }
  .how-n { width: 1.75rem; height: 1.75rem; border-radius: 6px; background: #f1f1f1; display: grid; place-items: center; font-weight: 700; font-size: .85rem; }
  .how-l { font-weight: 600; font-size: 1.02rem; }

  /* ---------- career ---------- */
  .group { margin: 0; padding: 1rem 1.5rem .4rem; color: var(--muted); font-weight: 600; font-size: .95rem; border-top: 1px solid var(--line); }
  .clubs { list-style: none; margin: 0; padding: 0 0 .5rem; }
  .clubs summary { list-style: none; display: grid; grid-template-columns: 2.4rem 1fr auto; gap: .85rem; align-items: center; padding: .7rem 1.5rem; cursor: pointer; }
  .clubs summary::-webkit-details-marker { display: none; }
  .clubs summary:hover { background: #fafafa; }
  .crest { width: 2.4rem; height: 2.4rem; border-radius: 50%; background: var(--c); color: #fff; display: grid; place-items: center; font-size: .75rem; font-weight: 800; }
  .club-txt { display: grid; }
  .club-txt strong { font-weight: 600; }
  .club-txt span { color: var(--muted); font-size: .88rem; }
  .chev { color: var(--muted); font-size: 1.35rem; transition: transform .15s; }
  .clubs details[open] .chev { transform: rotate(90deg); }
  .club-detail { margin: 0 1.5rem .9rem 4.75rem; padding-left: 1rem; color: #3d3d3d; font-size: .9rem; }
  .club-detail li + li { margin-top: .2rem; }
  .card-foot { display: flex; justify-content: space-between; gap: 1rem; margin: 0; padding: .9rem 1.5rem; border-top: 1px solid var(--line); font-size: .85rem; color: var(--muted); }
  .card-foot a { color: var(--ink); font-weight: 600; }

  /* ---------- ventures ---------- */
  .trophies { list-style: none; margin: 0 1.25rem 1.25rem; padding: 0; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
  .trophies li { display: grid; grid-template-columns: 4.75rem 1fr; gap: .75rem; padding: 1rem; }
  .trophies li + li { border-top: 1px solid var(--line); }
  .trophies p { margin: .15rem 0; color: var(--muted); font-size: .9rem; }
  .trophies a { font-weight: 600; font-size: .9rem; }
  .t-when { font-weight: 600; font-size: .9rem; color: var(--muted); }

  /* ---------- contact ---------- */
  .contact { padding-bottom: .5rem; }
  .row-link { display: flex; justify-content: space-between; gap: 1rem; padding: .8rem 1.5rem; border-top: 1px solid var(--line); text-decoration: none; }
  .row-link span { color: var(--muted); }
  .row-link strong { font-weight: 600; overflow-wrap: anywhere; text-align: right; }
  .row-link:hover { background: #fafafa; }

  .print-only { display: none; }
  @media print { .print-only { display: block; } }
</style>
