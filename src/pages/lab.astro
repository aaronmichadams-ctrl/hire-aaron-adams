---
/**
 * Checkpoint 2: three rough hero directions. Not linked from the site. noindex.
 * Real content only, pulled from src/data/aaron.ts.
 */
import Base from '../layouts/Base.astro';
import { person, tickets } from '../data/aaron';
import '@fontsource/archivo-black';
import '@fontsource/vt323';
import '@fontsource/courier-prime';
import '@fontsource/courier-prime/700.css';
import '@fontsource/atkinson-hyperlegible';
import '@fontsource/atkinson-hyperlegible/700.css';
import '@fontsource/bricolage-grotesque/800.css';
const shortProblems = tickets.map((t) => t.problem);
---
<Base title="Lab · three hero directions" noindex>
  <div class="lab-intro">
    <h1>Lab: three hero directions</h1>
    <p>Rough on purpose. Same real content in each. Pick one, or ask for a mix.</p>
    <p><strong>New:</strong> <a href="/lab/whiteboard">D. The Whiteboard</a>, a full scrolling prototype.</p>
  </div>

  <!-- ============ A. THE RAIL ============ -->
  <section class="lab-label"><h2>A. The Rail</h2><p>Literal kitchen pass. Steel rail, tickets clipped on, hanging off the right edge. Swipe the rail with a thumb.</p></section>
  <section class="a-hero">
    <div class="a-copy">
      <p class="a-kicker">{person.name} · {person.role} · {person.location}</p>
      <h2 class="a-h">Hand me<br/>a problem.</h2>
      <p class="a-sub">I build and run operations for growing businesses. Pick a ticket. I'll fire it.</p>
      <a class="a-cta" href={person.resumePdf}>Download resume</a>
    </div>
    <div class="a-rail-wrap">
      <div class="a-printer" aria-hidden="true"><span class="a-slot"></span><span class="a-led"></span></div>
      <div class="a-rail" aria-hidden="true"></div>
      <ul class="a-tickets">
        {tickets.map((t, i) => (
          <li class="a-ticket" style={`--r:${[-2, 1.5, -1, 2, -1.5][i]}deg`}>
            <span class="a-clip"></span>
            <span class="a-tno">{t.table} · #{String(i + 1).padStart(3, '0')}</span>
            <span class="a-prob">{t.problem}</span>
            <span class="a-fire">FIRE →</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ B. EXPO SCREEN ============ -->
  <section class="lab-label"><h2>B. Expo Screen</h2><p>A kitchen display system. Problems arrive as live orders with timers. On phones the "bump bar" sits at the bottom, right under the thumb.</p></section>
  <section class="b-hero">
    <div class="b-top">
      <span>STATION: {person.name.toUpperCase()}</span>
      <span class="b-blink">● LIVE</span>
      <span>{person.location.toUpperCase()}</span>
    </div>
    <h2 class="b-h">Hand me a problem.</h2>
    <p class="b-sub">{person.role}. Process, inventory, staffing, fulfillment, growth.</p>
    <ol class="b-orders">
      {tickets.slice(0, 4).map((t, i) => (
        <li class={`b-order ${i === 0 ? 'is-late' : ''}`}>
          <div class="b-order-head"><span>#{String(101 + i)}</span><span>{['04:12', '02:47', '01:05', '00:21'][i]}</span></div>
          <p>{t.problem}</p>
        </li>
      ))}
    </ol>
    <div class="b-bump">
      <button type="button">BUMP</button>
      <button type="button">RECALL</button>
      <button type="button" class="b-surprise">SURPRISE</button>
      <a href={person.resumePdf}>RESUME ↓</a>
    </div>
  </section>

  <!-- ============ C. THE RECEIPT IS THE PAGE ============ -->
  <section class="lab-label"><h2>C. The Receipt Is the Page</h2><p>The hero is one long thermal receipt, set off-center. The headline is a misregistered red rubber stamp, borrowed from a parking ticket where the stamp missed the box.</p></section>
  <section class="c-hero">
    <div class="c-receipt">
      <div class="c-store">
        <p class="c-store-name">AARON ADAMS<br/>OPERATIONS CO.</p>
        <p>{person.location.toUpperCase()}</p>
        <p>TEL {person.phone}</p>
        <p>{person.site.toUpperCase()}</p>
      </div>
      <p class="c-rule">================================</p>
      <p class="c-meta"><span>ORDER #2026</span><span>SERVER: AARON</span></p>
      <p class="c-rule">--------------------------------</p>
      <p class="c-q">WHAT ARE WE FIXING TODAY?</p>
      <ul class="c-items">
        {shortProblems.map((p) => (
          <li><span class="c-box" aria-hidden="true">[ ]</span> {p}</li>
        ))}
      </ul>
      <p class="c-rule">--------------------------------</p>
      <p class="c-line"><span>SUBTOTAL</span><span>1 OPERATOR</span></p>
      <p class="c-line c-total"><span>TOTAL</span><span>HIRED</span></p>
      <div class="c-barcode" aria-hidden="true"></div>
      <a class="c-cta" href={person.resumePdf}>TAKE YOUR RECEIPT (RESUME PDF)</a>
      <div class="c-stamp" aria-hidden="true">HAND ME<br/>A PROBLEM</div>
    </div>
    <div class="c-side">
      <h2 class="c-h">{person.name}</h2>
      <p>{person.positioning}</p>
    </div>
  </section>
</Base>

<style>
  :global(main) { max-width: none; padding: 0; }
  .lab-intro, .lab-label { max-width: 60rem; margin: 0 auto; padding: 1.5rem 1rem .5rem; }
  .lab-label h2 { margin: 1rem 0 .25rem; }
  .lab-label p { margin: 0 0 .75rem; color: #444; }

  /* ---------- A ---------- */
  .a-hero {
    --paper: #f6efe0; --ink: #1d1a16; --ketchup: #c8361f; --mustard: #e9b52b;
    background: var(--paper); color: var(--ink);
    display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.5rem; padding: 2rem 1rem 2.5rem; overflow: hidden;
    font-family: 'Atkinson Hyperlegible', sans-serif;
  }
  @media (min-width: 900px) { .a-hero { grid-template-columns: minmax(30rem, 6fr) 6fr; padding: 4rem 0 4rem 4rem; } }
  .a-kicker { font-family: 'Courier Prime', monospace; font-size: .9rem; margin: 0 0 .5rem; }
  .a-h { font-family: 'Archivo Black', sans-serif; font-size: clamp(3rem, 11vw, 5.5rem); line-height: .9; margin: 0; color: var(--ketchup); letter-spacing: -.02em; }
  .a-sub { font-size: 1.15rem; max-width: 26rem; }
  .a-cta { display: inline-block; background: var(--ink); color: var(--paper); padding: .8rem 1.1rem; font-weight: 700; text-decoration: none; border-radius: 4px; }
  .a-rail-wrap { position: relative; padding-top: 2.5rem; min-width: 0; }
  .a-printer { position: absolute; top: 0; left: 0; width: 9rem; height: 2.2rem; background: var(--ink); border-radius: 6px 6px 2px 2px; }
  .a-slot { position: absolute; left: 1rem; right: 1rem; bottom: .4rem; height: 4px; background: #555; }
  .a-led { position: absolute; right: .6rem; top: .6rem; width: 8px; height: 8px; border-radius: 50%; background: #3fbf6f; }
  .a-rail { height: 14px; margin-top: 1.2rem; background: linear-gradient(#e5e5e5, #9a9a9a 60%, #6d6d6d); border-radius: 7px; box-shadow: 0 3px 0 rgba(0,0,0,.15); }
  .a-tickets { list-style: none; margin: -6px 0 0; padding: 0 1rem 1.5rem 0; display: flex; gap: .9rem; overflow-x: auto; scroll-snap-type: x mandatory; }
  .a-ticket {
    flex: 0 0 11.5rem; scroll-snap-align: start; position: relative; transform: rotate(var(--r)); transform-origin: top center;
    background: #fffdf7; padding: 1.4rem .9rem 1.2rem; min-height: 12rem; display: flex; flex-direction: column; gap: .6rem;
    font-family: 'Courier Prime', monospace; box-shadow: 0 6px 14px rgba(29,26,22,.15);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 8px), 92% 100%, 84% calc(100% - 8px), 76% 100%, 68% calc(100% - 8px), 60% 100%, 52% calc(100% - 8px), 44% 100%, 36% calc(100% - 8px), 28% 100%, 20% calc(100% - 8px), 12% 100%, 4% calc(100% - 8px), 0 100%);
  }
  .a-clip { position: absolute; top: -2px; left: 50%; width: 2.6rem; height: 10px; transform: translateX(-50%); background: #8a8a8a; border-radius: 0 0 4px 4px; }
  .a-tno { font-size: .8rem; border-bottom: 1px dashed; padding-bottom: .3rem; }
  .a-prob { font-weight: 700; font-size: 1.1rem; line-height: 1.25; flex: 1; }
  .a-fire { align-self: flex-start; background: var(--ketchup); color: #fff; padding: .2rem .5rem; font-weight: 700; font-size: .85rem; }

  /* ---------- B ---------- */
  .b-hero {
    --bg: #15130f; --phos: #7cf29a; --amber: #f2b33d; --red: #ff6b57;
    background: radial-gradient(ellipse at 30% 0%, #23201a, var(--bg) 70%); color: var(--phos);
    font-family: 'VT323', monospace; padding: 1rem 1rem 6rem; position: relative; min-height: 42rem;
  }
  @media (min-width: 900px) { .b-hero { padding: 1.5rem 4rem 3rem; } }
  .b-top { display: flex; justify-content: space-between; gap: 1rem; font-size: 1.1rem; border-bottom: 2px solid #2e3a2f; padding-bottom: .4rem; flex-wrap: wrap; }
  .b-blink { color: var(--red); }
  .b-h { font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; color: #fff6e2; font-size: clamp(2.6rem, 9vw, 5.5rem); line-height: .95; margin: 1.5rem 0 .5rem; letter-spacing: -.03em; }
  .b-sub { font-size: 1.5rem; color: var(--amber); margin: 0 0 1.5rem; }
  .b-orders { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr)); gap: .75rem; }
  .b-order { border: 2px solid var(--phos); padding: .5rem .7rem; font-size: 1.5rem; line-height: 1.1; background: rgba(124,242,154,.05); }
  .b-order.is-late { border-color: var(--red); color: var(--red); }
  .b-order p { margin: .4rem 0 0; }
  .b-order-head { display: flex; justify-content: space-between; font-size: 1.2rem; opacity: .9; }
  .b-bump { position: absolute; left: 0; right: 0; bottom: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 2px; background: #000; }
  .b-bump > * { font: inherit; font-size: 1.4rem; padding: 1rem .25rem; background: #2a2620; color: var(--amber); border: 0; text-align: center; text-decoration: none; }
  .b-bump .b-surprise { color: var(--phos); }
  @media (min-width: 900px) { .b-bump { position: static; margin-top: 2rem; max-width: 40rem; } }

  /* ---------- C ---------- */
  .c-hero {
    --paper: #fbf6ea; --ink: #23201b; --stamp: #d23a24; --table: #e7c25a;
    background: var(--table) repeating-linear-gradient(90deg, rgba(0,0,0,.025) 0 2px, transparent 2px 9px);
    display: flex; flex-wrap: wrap; gap: 2rem; align-items: flex-start; padding: 2.5rem 1rem 3rem;
  }
  @media (min-width: 900px) { .c-hero { padding: 3rem 4rem 4rem 18%; flex-wrap: nowrap; } }
  .c-receipt {
    position: relative; width: min(22rem, 100%); background: var(--paper); color: var(--ink); padding: 1.5rem 1.25rem 2.5rem;
    font-family: 'Courier Prime', monospace; font-size: .95rem; transform: rotate(-1.2deg);
    box-shadow: 0 18px 30px rgba(60,40,0,.25);
    clip-path: polygon(0 0, 5% 6px, 10% 0, 15% 6px, 20% 0, 25% 6px, 30% 0, 35% 6px, 40% 0, 45% 6px, 50% 0, 55% 6px, 60% 0, 65% 6px, 70% 0, 75% 6px, 80% 0, 85% 6px, 90% 0, 95% 6px, 100% 0, 100% 100%, 95% calc(100% - 6px), 90% 100%, 85% calc(100% - 6px), 80% 100%, 75% calc(100% - 6px), 70% 100%, 65% calc(100% - 6px), 60% 100%, 55% calc(100% - 6px), 50% 100%, 45% calc(100% - 6px), 40% 100%, 35% calc(100% - 6px), 30% 100%, 25% calc(100% - 6px), 20% 100%, 15% calc(100% - 6px), 10% 100%, 5% calc(100% - 6px), 0 100%);
  }
  .c-store { text-align: center; }
  .c-store p { margin: 0; }
  .c-store-name { font-weight: 700; font-size: 1.3rem; line-height: 1.15; margin-bottom: .4rem !important; }
  .c-rule { margin: .5rem 0; overflow: hidden; white-space: nowrap; }
  .c-meta, .c-line { display: flex; justify-content: space-between; margin: .2rem 0; }
  .c-q { font-weight: 700; margin: .4rem 0; }
  .c-items { list-style: none; padding: 0; margin: 0; }
  .c-items li { padding: .35rem 0; border-bottom: 1px dotted #b9b0a0; }
  .c-total { font-weight: 700; font-size: 1.2rem; }
  .c-barcode { height: 3rem; margin: 1rem 0 .75rem; background: repeating-linear-gradient(90deg, var(--ink) 0 2px, transparent 2px 4px, var(--ink) 4px 7px, transparent 7px 8px, var(--ink) 8px 9px, transparent 9px 12px); }
  .c-cta { display: block; text-align: center; font-weight: 700; color: var(--ink); border: 2px solid var(--ink); padding: .6rem; text-decoration: none; }
  .c-stamp {
    position: absolute; top: 8.5rem; left: -1.2rem; transform: rotate(-9deg);
    font-family: 'Archivo Black', sans-serif; font-size: 2.6rem; line-height: .95; color: var(--stamp);
    border: 5px solid var(--stamp); padding: .35rem .6rem; mix-blend-mode: multiply; opacity: .9;
    -webkit-mask-image: radial-gradient(circle at 30% 40%, #000 60%, rgba(0,0,0,.55) 61%, #000 75%);
  }
  .c-side { max-width: 26rem; color: #2b2112; font-family: 'Atkinson Hyperlegible', sans-serif; font-size: 1.15rem; }
  .c-h { font-family: 'Archivo Black', sans-serif; font-size: clamp(2.4rem, 6vw, 4rem); line-height: .95; margin: 0 0 .75rem; }
</style>
