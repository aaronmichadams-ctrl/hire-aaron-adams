---
/**
 * The plain, corporate, print-friendly resume. Same content as the fun site.
 * Used by boring mode on "/" and as the whole page at "/resume".
 * Kept deliberately simple so it pastes cleanly into an ATS.
 */
import { person, results, jobs, skills, tools, education } from '../data/aaron';
const { headingLevel = 1 } = Astro.props as { headingLevel?: 1 | 2 };
const H = headingLevel === 1 ? 'h1' : 'h2';
---
<article class="resume" aria-label="Resume, plain version">
  <header class="r-head">
    <H class="r-name">{person.name}</H>
    <p class="r-role">{person.role} · {person.location}</p>
    <p class="r-contact">
      <a href={`mailto:${person.email}`}>{person.email}</a> ·
      <a href={person.phoneHref}>{person.phone}</a> ·
      <a href={person.url}>{person.site}</a>
      {person.linkedin.startsWith('http') ? <> · <a href={person.linkedin}>LinkedIn</a></> : <> · <span class="todo">{person.linkedin}</span></>}
    </p>
  </header>

  <section>
    <h2 class="r-h">Summary</h2>
    <p>{person.positioning}</p>
  </section>

  <section>
    <h2 class="r-h">Selected results</h2>
    <ul>
      {results.map((r) => <li>{r.plain} <span class="r-muted">({r.where.split(' · ')[0]})</span></li>)}
    </ul>
  </section>

  <section>
    <h2 class="r-h">Experience</h2>
    {jobs.map((s) => (
      <div class="r-job">
        <h3 class="r-job-title">
          <span>{s.title}, {s.org}</span>
          <span class="r-dates">{s.dates}</span>
        </h3>
        <ul>
          {s.ran.map((line) => <li>{line}</li>)}
        </ul>
      </div>
    ))}
  </section>

  <section>
    <h2 class="r-h">Skills</h2>
    <ul class="r-skills">
      {skills.map((s) => <li><strong>{s.name}:</strong> {s.items}</li>)}
      <li><strong>Tools:</strong> {tools}</li>
    </ul>
  </section>

  <section>
    <h2 class="r-h">Education</h2>
    <p><strong>{education.degree}</strong>, {education.school}, {education.year}</p>
    <p>{education.extra} {education.leadership}.</p>
  </section>
</article>
